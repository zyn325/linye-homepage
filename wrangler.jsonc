{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guangluqi",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "vars": { "ADMIN_USERNAME": "作者大大", "ADMIN_CREATED_BEFORE": "2026-11-28T01:53:46+08:00" },
  "routes": [
    { "pattern": "guangluqi.com", "custom_domain": true },
    { "pattern": "www.guangluqi.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws", "/health"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ChessRoom" },
      { "name": "ACCOUNTS", "class_name": "AccountDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChessRoom"] },
    { "tag": "v2-accounts", "new_sqlite_classes": ["AccountDirectory"] }
  ]
}
