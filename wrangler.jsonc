{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guangluqi",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ChessRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChessRoom"] }]
}
